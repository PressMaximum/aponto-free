msgid "Closed"
msgstr "Đóng cửa"

#: assets/src/wizard/index.js:1079
msgid ""
"Lunch breaks and split shifts: add more hours per day later in Settings → "
"Business hours."
msgstr ""

#: assets/src/wizard/index.js:1091
msgid "Who takes the bookings?"
msgstr "Ai sẽ nhận lịch đặt?"

#: assets/src/wizard/index.js:1094
msgid ""
"We prefilled you. You can add the rest of your team from the Staff screen."
msgstr ""

#: assets/src/wizard/index.js:1098
msgid "We prefilled you. Add more staff later with Premium."
msgstr "Chúng tôi đã điền sẵn bạn. Thêm nhân viên khác sau với bản Premium."


{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "aponto/booking-form",
  "version": "1.1.1",
  "title": "Aponto Booking Form",
  "category": "widgets",
  "icon": "calendar-alt",
  "description": "Let visitors book an appointment — choose a service, date and time, and confirm.",
  "keywords": [
    "booking",
    "appointment",
    "aponto",
    "calendar",
    "schedule"
  ],
  "textdomain": "aponto",
  "attributes": {
    "serviceId": {
      "type": "integer"
    },
    "staffId": {
      "type": "integer"
    },
    "locationId": {
      "type": "integer"
    },
    "layout": {
      "type": "string",
      "default": "default",
      "enum": [
        "default",
        "one-page"
      ]
    },
    "accent": {
      "type": "string",
      "default": ""
    },
    "radius": {
      "type": "number"
    },
    "colorScheme": {
      "type": "string",
      "default": "light"
    },
    "maxWidth": {
      "type": "number"
    },
    "summaryMode": {
      "type": "string",
      "default": "always",
      "enum": [
        "always",
        "step2",
        "off"
      ]
    },
    "stepDisplay": {
      "type": "string",
      "default": "horizontal",
      "enum": [
        "fraction",
        "horizontal"
      ]
    },
    "staffLayout": {
      "type": "string",
      "default": "",
      "enum": [
        "",
        "list",
        "cards"
      ]
    },
    "align": {
      "type": "string"
    },
    "shadow": {
      "type": "string",
      "default": "sm",
      "enum": [
        "flat",
        "sm",
        "md",
        "lg"
      ]
    },
    "contactHelp": {
      "type": "boolean",
      "default": true
    },
    "contactText": {
      "type": "string",
      "default": ""
    },
    "preselectDate": {
      "type": "boolean"
    },
    "showHost": {
      "type": "boolean"
    },
    "meetingType": {
      "type": "string",
      "default": "",
      "enum": [
        "",
        "in_person",
        "phone",
        "online",
        "custom"
      ]
    },
    "meetingText": {
      "type": "string",
      "default": ""
    }
  },
  "example": {
    "viewportWidth": 960
  },
  "supports": {
    "html": false,
    "customClassName": false,
    "reusable": true,
    "multiple": true,
    "align": [
      "wide",
      "full"
    ]
  }
}
